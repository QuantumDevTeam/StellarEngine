<Project Sdk="Microsoft.NET.Sdk">
    <!-- Versions -->
    <Import Project="..\..\..\..\Data\version.props"/>

    <!-- Workload Setup Targets -->
    <Import Project="WorkloadSetup.targets"
            Condition="'$(IsPacking)' == 'true'"/>

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>

        <Version>$(StellarSdkVersion)</Version>
        <AssemblyVersion>$(StellarSdkVersion)</AssemblyVersion>

        <IsPackable>true</IsPackable>
        <Authors>QuantumDev</Authors>
        <PackageId>Stellar.Sdk</PackageId>
        <Description>StellarEngine .NET SDK wrapper</Description>
        <PackageVersion>$(Version)</PackageVersion>

        <DevelopmentDependency>true</DevelopmentDependency>

        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeReferencedProjects>true</IncludeReferencedProjects>
        <NoPackageAnalysis>true</NoPackageAnalysis>
    </PropertyGroup>

    <ItemGroup>
        <!-- sdk deps -->
        <None Include="Sdk.props" Pack="true" PackagePath="Sdk/"/>
        <None Include="Sdk.targets" Pack="true" PackagePath="Sdk/"/>

        <None Include="..\..\..\..\Data\version.props" Pack="true" PackagePath="Sdk/"/>
        <None Include="StellarUsageDefinations.props" Pack="true" PackagePath="Sdk/"/>
    </ItemGroup>

    <ItemGroup>
        <!-- copying -->
        <None Include="..\Stellar.Sdk.Tasks\bin\Release\netstandard2.0\Stellar.Sdk.Tasks.dll"
              Pack="true" PackagePath="build/Stellar.Sdk.Tasks.dll"/>
    </ItemGroup>
</Project>
